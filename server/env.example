# ─────────────────────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─────────────────────────────────────────────────────────────
# DATABASE (MySQL)
# ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_db_name
# PRODUCTION: do NOT use root. Create a least-privilege account with only
# SELECT/INSERT/UPDATE/DELETE on this database (no GRANT/DROP/superuser).
DB_USER=root
DB_PASSWORD=your_db_password
DB_DIALECT=mysql

# ─────────────────────────────────────────────────────────────
# JWT
# Used by your existing authenticate middleware (decoded.id)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_64_chars_access
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─────────────────────────────────────────────────────────────
# OTP
# ─────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────────────────────
# CORS
# Comma-separated list of allowed frontend origins (exact, scheme + host).
# In production list BOTH the public site and the admin subdomain, e.g.:
#   ALLOWED_ORIGINS=https://wiibienergy.com,https://admin.wiibienergy.com
# Both must talk to this ONE API origin so the auth cookie works for each.
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
APP_NAME=Wiibi Energy
# Public base URL — used to build absolute image URLs in local storage mode
APP_URL=https://yourdomain.com

# ─────────────────────────────────────────────────────────────
# PAYMENTS
# ─────────────────────────────────────────────────────────────
# Provider: "mock" (default, dev) or "paystack" (production)
# NODE_ENV=production also forces Paystack regardless of this setting.
PAYMENT_PROVIDER=mock

# URLs used by the payment flow
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:5000

# Mock provider (dev/test only)
MOCK_PAYMENT_FAIL_RATE=0
# Must be long enough for a human to click Pay / Simulate Failed on the mock
# gateway before the auto success webhook fires (it pays the order otherwise).
MOCK_WEBHOOK_DELAY_MS=45000
MOCK_WEBHOOK_SECRET=mock_webhook_secret_dev

# Paystack (required when PAYMENT_PROVIDER=paystack)
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=your_paystack_webhook_secret

# ─────────────────────────────────────────────────────────────
# EMAIL (SMTP)
# Order status + payment confirmation emails to customers.
# Leave SMTP_HOST blank to disable emails (dev-friendly no-op).
# ─────────────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Wiibi Energy <no-reply@wiibienergy.com>"
# Reply-To + footer contact address (defaults to the EMAIL_FROM address).
SUPPORT_EMAIL=support@wiibienergy.com
# Postal address shown in every email footer (CAN-SPAM compliance).
COMPANY_ADDRESS="Wiibi Energy, Lagos, Nigeria"

# ─────────────────────────────────────────────────────────────
# STORAGE
# "local"       → serve from server/public/uploads/ (default, dev-friendly)
# "digitalocean" → upload to DigitalOcean Spaces (use in production)
# ─────────────────────────────────────────────────────────────
STORAGE_PROVIDER=local
MAX_FILE_SIZE_BYTES=5242880

# DigitalOcean Spaces (required when STORAGE_PROVIDER=digitalocean)
DO_SPACES_KEY=your_spaces_access_key_id
DO_SPACES_SECRET=your_spaces_secret_access_key
DO_SPACES_REGION=nyc3
DO_SPACES_BUCKET=your-space-name
# Optional CDN endpoint (leave blank to use the default Spaces URL)
DO_SPACES_CDN_URL=
