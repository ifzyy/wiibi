# Database
DB_HOST=localhost
DB_USER=root
DB_PASSWORD="Johnson#2#3"
DB_NAME=wiibi

# Pool tuning (optional - good defaults already in code)
DB_POOL_MAX=10
DB_POOL_MIN=0

# Other app config (already used in auth)

PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# JWT
# Used by your existing authenticate middleware (decoded.id)
# ─────────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string_min_64_chars_access
JWT_REFRESH_SECRET=change_this_to_a_different_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─────────────────────────────────────────────────────────────
# OTP
# ─────────────────────────────────────────────────────────────
OTP_LENGTH=6
OTP_EXPIRES_MINUTES=5
OTP_MAX_ATTEMPTS=5

# ─────────────────────────────────────────────────────────────
# RATE LIMITING
# ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX=100

# ─────────────────────────────────────────────────────────────
# CORS
# Comma-separated list of allowed frontend origins
# ─────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
