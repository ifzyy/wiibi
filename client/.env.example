# ─────────────────────────────────────────────────────────────
# Client (Vite) environment
# Copy to .env and adjust. Only VITE_* vars are exposed to the browser.
# ─────────────────────────────────────────────────────────────

# Base URL of the API (include the /api suffix).
#   dev:        http://localhost:5000/api
#   production: https://api.wiibienergy.com/api
# IMPORTANT: the public site AND the admin subdomain build must point at the
# SAME API origin, otherwise the auth cookie won't be shared between them.
VITE_API_URL=http://localhost:5000/api

# Google OAuth client id (One Tap / sign-in button).
VITE_GOOGLE_CLIENT_ID=

# ─────────────────────────────────────────────────────────────
# Admin subdomain (Option A deployment)
# ─────────────────────────────────────────────────────────────
# The SAME build is served on both hostnames. When the app detects it's being
# served from a host starting with "admin." it redirects "/" to "/admin"
# automatically (see App.jsx → AdminHostRedirect). No separate build needed.
#
# DNS:  admin.wiibienergy.com  →  same static host as wiibienergy.com
# CORS: add https://admin.wiibienergy.com to the API's ALLOWED_ORIGINS.
